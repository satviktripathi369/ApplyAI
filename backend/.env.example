# ApplyAI Environment Variables
# Create a copy of this file named '.env' and fill in the keys you want to use.

# OpenAI API Key (if using openai provider)
OPENAI_API_KEY="sk-..."

# Google Gemini API Key (if using gemini provider)
GEMINI_API_KEY="..."

# Anthropic Claude API Key (if using anthropic provider)
ANTHROPIC_API_KEY="sk-ant-..."
